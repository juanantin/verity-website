# Required for the "Ask Verity" live terminal (app/api/verity/route.ts)
# and the X reply bot (app/api/cron/verity-bot/route.ts).
# Without this set, the terminal falls back to the canned glitchy responses.
ANTHROPIC_API_KEY=

# X (Twitter) OAuth 1.0a user-context credentials for @VERITYtoken_, from a
# developer.x.com app with "Read and write" permissions. See README.md for
# the full setup steps.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Shared secret the scheduler sends as "Authorization: Bearer <value>" to
# authenticate calls to /api/cron/verity-bot. Generate with:
#   openssl rand -hex 32
CRON_SECRET=
